cabal-version: 2.4
name: mgw
version: 0.1.0.0
synopsis: Message Gateway - каноническая модель сообщений
description: Типы, законы, генераторы для тестов
license: MIT
author: Dominicusin
maintainer: admin@example.org
category: Network
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules:
    MGW.Model
  build-depends:
    base >= 4.18 && < 5,
    aeson >= 2.0,
    text >= 2.0,
    bytestring >= 0.12,
    containers >= 0.6,
    time >= 1.12,
    uuid >= 1.3,
    hedgehog >= 1.4
  default-language: GHC2021
  ghc-options: -Wall -Wcompat -Werror -Wpartial-fields -Wincomplete-patterns

test-suite mgw-model-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    MGW.Gen
  build-depends:
    base,
    mgw,
    hedgehog >= 1.4,
    tasty >= 1.5,
    tasty-hedgehog >= 1.4,
    tasty-hunit >= 0.10
  default-language: GHC2021
  ghc-options: -Wall -Wcompat